# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Nothing here is read inside `step()`. The environment is fully offline and
# deterministic without any of these — they are used by one-off build scripts and by
# the optional LLM configurations.

# --- World build, run once, result committed -------------------------------------
# Google Distance Matrix. Used only by `scripts/fetch_transfer_matrix.py`, which writes
# `data/transfer_matrix.json`. Without it, `travel_env/geo.py` falls back to per-city
# transit profiles and everything still runs.
# Enable "Distance Matrix API" in Google Cloud Console -> APIs & Services -> Library.
GOOGLE_MAPS_API_KEY=

# --- LLM configurations (optional) -------------------------------------------------
# Any OpenAI-compatible gateway. Used by the LLM client simulator and the LLM agent
# adapter. The masked-Discrete policy path never calls it.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# The fallback when LLM_API_KEY is not set.
OPENROUTER_API_KEY=
